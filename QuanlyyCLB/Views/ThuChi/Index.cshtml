@model List<GiaoDich>
@{
    ViewData["Title"] = "Sổ thu chi";
    decimal thu = (decimal)ViewBag.Thu, chi = (decimal)ViewBag.Chi;               // tổng toàn CLB, ai cũng xem được
    bool coGhi = User.IsInRole("ChuNhiem") || User.IsInRole("PhuTrach");
    bool laTV = User.IsInRole("ThanhVien") && User.MaTV() != null;
    bool xemChiTiet = !User.IsInRole("ThanhVien") || Model.Any();                 // thành viên chỉ thấy bảng khi đã được cấp quyền
    var choCap = (System.Data.DataTable)ViewBag.ChoCap;
    var nhom = (System.Data.DataTable)ViewBag.Nhom;
    var hd = (System.Data.DataTable)ViewBag.HoatDong;
}
@section Actions {
    @if (coGhi)
    {
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mGD"><i class="bi bi-plus-lg"></i> Ghi giao dịch</button>
    }
    @if (laTV)
    {
        <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#mQuyen"><i class="bi bi-eye"></i> Xin quyền xem chi tiết</button>
    }
}
<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="stat"><span class="num text-success">@Ui.Tien(thu)</span>Tổng thu</div></div>
    <div class="col-md-4"><div class="stat"><span class="num text-danger">@Ui.Tien(chi)</span>Tổng chi</div></div>
    <div class="col-md-4"><div class="stat"><span class="num text-primary">@Ui.Tien(thu - chi)</span>Số dư</div></div>
</div>

@* Yêu cầu xem chi tiết đang chờ người này cấp (trưởng nhóm hoặc Chủ nhiệm) *@
@if (choCap.Rows.Count > 0)
{
    <div class="card-box mb-3">
        <h3 class="h6 fw-semibold mb-3">Yêu cầu xem chi tiết đang chờ bạn cấp quyền</h3>
        <div class="table-responsive">
            <table class="table table-striped-custom align-middle">
                <thead><tr><th>Thành viên</th><th>Phạm vi</th><th>Lý do</th><th></th></tr></thead>
                <tbody>
                    @foreach (System.Data.DataRow r in choCap.Rows)
                    {
                        var pv = Ui.Nhan(r["PhamVi"]) + (r["TenNhom"] is DBNull ? "" : ": " + r["TenNhom"]) + (r["TenHoatDong"] is DBNull ? "" : ": " + r["TenHoatDong"]);
                        <tr>
                            <td>@r["HoTen"]</td><td>@pv</td><td>@r["LyDoYeuCau"]</td>
                            <td class="text-end">
                                <form method="post" asp-action="CapQuyen" class="d-inline"><input type="hidden" name="id" value="@r["MaQuyenXem"]" /><input type="hidden" name="dong" value="true" /><button class="btn btn-sm btn-success">Cấp</button></form>
                                <form method="post" asp-action="CapQuyen" class="d-inline"><input type="hidden" name="id" value="@r["MaQuyenXem"]" /><input type="hidden" name="dong" value="false" /><button class="btn btn-sm btn-danger">Từ chối</button></form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (xemChiTiet)
{
    <div class="card-box">
        <div class="table-responsive">
            <table class="table table-striped-custom align-middle">
                <thead><tr><th>Ngày</th><th>Nội dung</th><th>Loại</th><th class="text-end">Số tiền</th><th>Người thực hiện</th></tr></thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td>@g.Ngay.ToString("dd/MM/yyyy")</td><td>@g.NoiDung</td>
                            <td><span class="badge @(g.Loai == "Thu" ? "bg-success" : "bg-danger")">@g.Loai</span></td>
                            <td class="text-end @(g.Loai == "Thu" ? "text-success" : "text-danger")">@(g.Loai == "Thu" ? "+" : "-")@Ui.Tien(g.SoTien)</td>
                            <td>@g.NguoiThucHien</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card-box text-center text-muted">Bạn đang xem được tổng thu, tổng chi. Muốn xem chi tiết, hãy bấm "Xin quyền xem chi tiết".</div>
}

<div class="modal fade" id="mGD" tabindex="-1">
    <div class="modal-dialog">
        <form class="modal-content" method="post" asp-action="Ghi">
            <div class="modal-header"><h5 class="modal-title">Ghi giao dịch</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <label class="form-label">Loại</label>
                <select name="loai" class="form-select mb-3"><option>Thu</option><option>Chi</option></select>
                <label class="form-label">Số tiền (đ)</label><input type="number" name="soTien" min="1" class="form-control mb-3" required />
                <label class="form-label">Nội dung</label><input name="noiDung" class="form-control" required />
                <label class="form-label mt-3">Hoạt động (nếu có)</label>
                <select name="maHD" class="form-select"><option value="">Không gắn hoạt động</option>@foreach (System.Data.DataRow r in hd.Rows) { <option value="@r["MaHD"]">@r["TenHoatDong"]</option> }</select>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Lưu</button></div>
        </form>
    </div>
</div>

@* Form xin quyền xem chi tiết (sp_XinQuyenXemChiTiet) *@
<div class="modal fade" id="mQuyen" tabindex="-1">
    <div class="modal-dialog">
        <form class="modal-content" method="post" asp-action="XinQuyen">
            <div class="modal-header"><h5 class="modal-title">Xin quyền xem chi tiết thu chi</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <label class="form-label">Phạm vi</label>
                <select name="phamVi" class="form-select mb-3">
                    <option value="Nhom">Theo nhóm (trưởng nhóm cấp)</option>
                    <option value="HoatDong">Theo hoạt động (Chủ nhiệm cấp)</option>
                     <option value="CLB">Toàn CLB (Chủ nhiệm cấp)</option>
                </select>
                <label class="form-label">Nhóm (nếu chọn phạm vi nhóm)</label>
                <select name="maNhom" class="form-select mb-3">
                    <option value="">Chưa chọn</option>
                    @foreach (System.Data.DataRow r in nhom.Rows) { <option value="@r["MaNhom"]">@r["TenNhom"]</option> }
                </select>
                <label class="form-label">Hoạt động (nếu chọn phạm vi hoạt động)</label>
                <select name="maHD" class="form-select mb-3">
                    <option value="">Chưa chọn</option>
                    @foreach (System.Data.DataRow r in hd.Rows) { <option value="@r["MaHD"]">@r["TenHoatDong"]</option> }
                </select>
                <label class="form-label">Lý do</label><textarea name="lyDo" class="form-control" rows="2" required></textarea>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Gửi yêu cầu</button></div>
        </form>
    </div>
</div>
