@model List<HoatDong>
@{
    ViewData["Title"] = "Hoạt động";
    string tab = (string)ViewBag.Tab;
    var tabs = new List<(string key, string label)> { ("Đã duyệt", "Sắp diễn ra"), ("Đang diễn ra", "Đang diễn ra"), ("Kết thúc", "Đã kết thúc") };
    if (!User.IsInRole("ThanhVien")) { tabs.Add(("Chờ duyệt", "Chờ duyệt")); tabs.Add(("Dự thảo", "Dự thảo")); }
}
@section Actions {
    @if (User.IsInRole("ChuNhiem") || User.IsInRole("PhuTrach"))
    {
        <a class="btn btn-primary" asp-action="DeXuat"><i class="bi bi-plus-lg"></i> Đề xuất hoạt động</a>
    }
}
<ul class="nav nav-pills mb-3">
    @foreach (var t in tabs)
    {
        <li class="nav-item"><a class="nav-link @(tab == t.key ? "active" : "")" asp-action="Index" asp-route-tab="@t.key">@t.label</a></li>
    }
</ul>
@if (!Model.Any())
{
    <div class="card-box text-center text-muted py-5"><i class="bi bi-inbox display-4"></i><div class="mt-2">Chưa có dữ liệu</div></div>
}
<div class="row g-3">
    @foreach (var h in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card-box h-100 p-0 overflow-hidden">
                <div class="cover"><i class="bi bi-image"></i></div>
                <div class="p-3">
                    <h3 class="h6 fw-semibold">@h.Ten</h3>
                    <div class="small text-muted mb-1"><i class="bi bi-clock"></i> @h.BatDau.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="small text-muted mb-2"><i class="bi bi-geo-alt"></i> @h.DiaDiem</div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge @Ui.Badge(h.TrangThai)">@h.TrangThai</span>
                        <span class="small">Đã đăng ký @h.DangKy.Count/@(h.SoLuongToiDa == 0 ? "∞" : h.SoLuongToiDa.ToString())</span>
                    </div>
                    <a class="btn btn-sm btn-outline-primary mt-3" asp-action="ChiTiet" asp-route-id="@h.Id">Xem chi tiết</a>
                </div>
            </div>
        </div>
    }
</div>