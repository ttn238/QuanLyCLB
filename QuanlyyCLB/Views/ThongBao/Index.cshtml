@using System.Data
@model DataTable
@{ ViewData["Title"] = "Thông báo"; }
<div class="card-box">
    @if (Model.Rows.Count == 0) { <div class="text-muted">Chưa có thông báo</div> }
    <div class="list-group list-group-flush">
        @foreach (DataRow r in Model.Rows)
        {
            bool da = (bool)r["DaDoc"];
            <div class="list-group-item d-flex justify-content-between align-items-start px-0">
                <div>
                    <div class="@(da ? "text-muted" : "fw-semibold")">@r["TieuDe"]</div>
                    <div class="small">@r["NoiDung"]</div>
                    <div class="small text-muted">@Convert.ToDateTime(r["NgayTao"]).ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                @if (!da)
                {
                    <form method="post" asp-action="DaDoc"><input type="hidden" name="id" value="@r["MaNhan"]" /><button class="btn btn-sm btn-outline-primary">Đã đọc</button></form>
                }
            </div>
        }
    </div>
</div>
