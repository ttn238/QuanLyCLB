@{
    ViewData["Title"] = "Dashboard";
    var hoTen = User.FindFirst("HoTen")?.Value;
    var sapToi = (List<HoatDong>)ViewBag.SapToi;
    decimal soDu = (decimal)ViewBag.SoDu;
}
<h2 class="h5 mb-3">Xin chào, @hoTen</h2>

<div class="row g-3 mb-4">
    @if (User.IsInRole("ChuNhiem") || User.IsInRole("GiangVien"))
    {
        <div class="col-md-4"><a class="stat" asp-controller="HoatDong" asp-action="Index" asp-route-tab="Chờ duyệt"><span class="num text-warning">@ViewBag.ChoDuyet</span>Hoạt động chờ duyệt</a></div>
    }
    @if (User.IsInRole("ChuNhiem"))
    {
        <div class="col-md-4"><a class="stat" asp-controller="ThanhVien" asp-action="Index"><span class="num text-danger">@ViewBag.KhongHD</span>Thành viên không hoạt động</a></div>
    }
    @if (!User.IsInRole("ThanhVien"))
    {
        <div class="col-md-4"><a class="stat" asp-controller="TaiSan" asp-action="Index"><span class="num text-primary">@ViewBag.PhieuCho</span>Phiếu mượn chờ duyệt</a></div>
        <div class="col-md-4"><a class="stat" asp-controller="ThuChi" asp-action="Index"><span class="num text-success">@Ui.Tien(soDu)</span>Số dư quỹ</a></div>
    }
    @if (User.IsInRole("ThanhVien"))
    {
        <div class="col-md-4"><div class="stat"><span class="num text-success">@ViewBag.DaThamGia</span>Hoạt động đã tham gia</div></div>
    }
</div>

<div class="card-box">
    <h3 class="h6 fw-semibold mb-3">Hoạt động sắp tới</h3>
    @if (!sapToi.Any())
    {
        <div class="text-muted">Chưa có dữ liệu</div>
    }
    <div class="list-group list-group-flush">
        @foreach (var h in sapToi)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                <div>
                    <div class="fw-medium">@h.Ten</div>
                    <div class="small text-muted"><i class="bi bi-clock"></i> @h.BatDau.ToString("dd/MM/yyyy HH:mm") · <i class="bi bi-geo-alt"></i> @h.DiaDiem</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @Ui.Badge(h.TrangThai)">@h.TrangThai</span>
                    <a class="btn btn-sm btn-outline-primary" asp-controller="HoatDong" asp-action="ChiTiet" asp-route-id="@h.Id">Xem</a>
                </div>
            </div>
        }
    </div>
</div>